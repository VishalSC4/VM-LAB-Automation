ENVIRONMENT=production
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

POSTGRES_DB=cloudlabs
POSTGRES_USER=cloudlabs
POSTGRES_PASSWORD=replace-me

GUAC_POSTGRES_DB=guacamole_db
GUAC_POSTGRES_USER=guacamole_user
GUAC_POSTGRES_PASSWORD=replace-me-too
GUACAMOLE_PUBLIC_URL=https://labs.yourdomain.com
GUACAMOLE_ADMIN_USER=guacadmin
GUACAMOLE_ADMIN_PASSWORD=replace-with-a-strong-guacamole-password

AWS_REGION=ap-south-1
DEFAULT_VPC_ID=vpc-xxxxxxxx
LAB_SUBNET_ID=subnet-xxxxxxxx
LAB_SECURITY_GROUP_ID=sg-xxxxxxxx
LAB_KEY_NAME=
LAB_IAM_INSTANCE_PROFILE=
LAB_INSTANCE_MARKET=auto
LAB_SPOT_ENABLED=true
LAB_SPOT_MAX_PRICE=
LAB_SPOT_FALLBACK_TO_ON_DEMAND=true
LAB_SPOT_INSTANCE_TYPES=c6a.xlarge,c5a.xlarge,c6i.xlarge,c5.xlarge,m6a.xlarge,m5a.xlarge,m5.xlarge
LAB_ROOT_VOLUME_SIZE_GB=64
WINDOWS_ADMIN_USER=Administrator
CLEANUP_INTERVAL_SECONDS=60
